{
  "name": "agent-pay",
  "version": "0.1.0",
  "description": "Let an AI agent buy things over HTTP. x402 payments with spend caps, payee allowlists, and no private keys in your process.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "keywords": [
    "x402",
    "ai-agent",
    "agent-payments",
    "stablecoin",
    "usdc",
    "http-402",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armdeployment/agent-pay.git"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
